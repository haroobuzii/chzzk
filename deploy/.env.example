# 배포 서버용 .env 예시. 서버의 /srv/chzzk에 compose.yml과 함께 .env로 복사해서 채운다.
# .env는 git에 올라가지 않는다. 아래 값은 모두 자리표시자다. 실제 값은 서버의 .env에만 둔다.

# PostgreSQL 비밀번호. 서버에서 처음 한 번 무작위로 만든다(개발용 chzzk를 쓰지 않는다).
# DB 주소(DATABASE_URL)에 그대로 들어가므로 영문·숫자만 쓰는 hex로 만든다.
#   sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=$(openssl rand -hex 24)/" .env   (값은 화면에 나오지 않는다)
# DB가 한 번 만들어진 뒤에 이 값만 바꾸면 앱이 접속하지 못한다(compose.yml의 db 설명 참고).
DB_PASSWORD=여기에_openssl_rand_hex_24로_만든_값

# 토스페이먼츠 테스트 키(후원). 사용자 본인의 test_ck_…·test_sk_… 키를 넣는다.
# 둘 다 비워 두면 후원 기능만 끈 채로 켜진다. 형식: test_ck_여기에_내_테스트_클라이언트_키, test_sk_여기에_내_테스트_시크릿_키
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 다운로드 페이지(/download)의 iOS TestFlight 공개 링크. 비워 두면 "준비 중"으로 나온다.
# 형식: https://testflight.apple.com/join/여기에_공개_링크_코드
TESTFLIGHT_URL=

# 서버의 공인 IP. MediaMTX가 휴대폰·시청자에게 영상(UDP 8189)을 받을 주소로 알린다.
PUBLIC_IP=203.0.113.10

# Caddy가 인증서를 받을 도메인. DNS A 레코드가 PUBLIC_IP를 가리켜야 한다(Cloudflare는 DNS only).
DOMAIN=chzzk.haroobuzii.com

# 앱 이미지 태그(ghcr.io/haroobuzii/chzzk:<태그>). 자동 배포는 커밋 해시로 바꿔 넣는다.
IMAGE_TAG=latest

# MediaMTX 경로 앞부분. 적지 않으면 live를 쓴다.
# LIVE_PATH_PREFIX=live

# --- 로컬 확인(이 맥에서 운영용 묶음을 통째로 띄워 볼 때) ---
# 이 파일을 deploy/.env.local 같은 이름으로 복사해 아래처럼 바꾸고, 개발용 compose와 겹치지 않게 띄운다.
#   DB_PASSWORD=$(openssl rand -hex 24)로 만든 값
#   TOSS_CLIENT_KEY=, TOSS_SECRET_KEY= (비워서 후원 끔)
#   PUBLIC_IP=$(ipconfig getifaddr en0)
#   DOMAIN=localhost        ← Caddy가 Let's Encrypt 대신 스스로 만든 내부 인증서를 쓴다
#   IMAGE_TAG=local         ← 맥에서 만든 이미지(Dockerfile 머리말의 buildx 명령)
#   HTTP_PORT=8003, HTTPS_PORT=8443, WEBRTC_UDP_PORT=8193  ← 80·443·8189와 겹치지 않게
# 띄우기·확인·내리기:
#   docker compose -p chzzk-t03 -f deploy/compose.yml --env-file deploy/.env.local up -d
#   curl -k https://localhost:8443/healthz
#   docker compose -p chzzk-t03 -f deploy/compose.yml --env-file deploy/.env.local down -v
# 서버에서는 아래 셋을 적지 않는다(기본값 80·443·8189).
# HTTP_PORT=80
# HTTPS_PORT=443
# WEBRTC_UDP_PORT=8189
