# 이 파일을 .env로 복사해서 쓴다. .env는 git에 올라가지 않는다.
# 아래 값은 모두 로컬 개발용 예시다.

# PostgreSQL 접속 주소. docker-compose.yml의 로컬 개발용 DB를 가리킨다.
DATABASE_URL=postgres://chzzk:chzzk@localhost:5433/chzzk

# 영상 보관 폴더. 적지 않으면 ./data를 쓴다.
DATA_DIR=./data

# 업로드 최대 크기(바이트). 적지 않으면 2 GiB(2147483648)다.
MAX_UPLOAD_BYTES=2147483648

# MediaMTX의 WebRTC HTTP(WHIP/WHEP) 주소. 적지 않으면 http://localhost:8889를 쓴다.
MEDIAMTX_WEBRTC_URL=http://localhost:8889

# MediaMTX의 관리 API 주소. 적지 않으면 http://localhost:9997을 쓴다.
MEDIAMTX_API_URL=http://localhost:9997

# MediaMTX 경로 앞부분. 적지 않으면 live를 쓴다(방송 3번 → live/3).
# 작업 폴더 여러 개가 MediaMTX 하나를 함께 쓸 때만 폴더마다 다르게 둔다(예: live-t33).
# LIVE_PATH_PREFIX=live

# 토스페이먼츠 테스트 키(후원). 개발자센터(https://developers.tosspayments.com/my/api-keys)의
# "API 개별 연동 키"에서 받은 test_ck_…·test_sk_… 키를 넣는다. 아래 값은 자리표시자다.
# 둘 다 비워 두면 후원 기능만 끈 채로 켜진다. 하나만 넣거나 test_로 시작하지 않는 키를 넣으면 서버가 켜지지 않는다.
# 시크릿 키는 .env에만 두고 저장소에 올리지 않는다.
# TOSS_CLIENT_KEY=test_ck_여기에_내_테스트_클라이언트_키
# TOSS_SECRET_KEY=test_sk_여기에_내_테스트_시크릿_키

# 토스 API 주소. 적지 않으면 https://api.tosspayments.com을 쓴다.
# TOSS_API_URL=https://api.tosspayments.com

# 승인을 일부러 실패시켜 실패 화면을 볼 때만 넣는다(테스트 키일 때만). 예: REJECT_CARD_PAYMENT
# TOSS_TEST_FAIL_CODE=

# 이 컴퓨터의 와이파이 IP. docker compose가 MediaMTX에 넘겨, 휴대폰이 영상을 보낼 주소로 쓴다.
# macOS에서는 `ipconfig getifaddr en0`으로 찾는다.
LAN_IP=192.168.0.10
